CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# Raspberry Pi 5 DSI display pipeline (Freenove FNK0078B / 7-inch 800x480)
CONFIG_DRM=y
CONFIG_DRM_VC4=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_TOSHIBA_TC358762=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_I2C=y
CONFIG_REGULATOR_RASPBERRYPI_TOUCHSCREEN_ATTINY=y

# EDT FT5x06-compatible touch controller used by the DSI overlay
CONFIG_INPUT=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y
